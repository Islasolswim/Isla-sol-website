*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --sand: #f5f0e8;
  --warm-white: #faf8f4;
  --deep: #1a1714;
  --mid: #6b6460;
  --accent: #c8a882;
  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans: 'Jost', sans-serif;
}

html { scroll-behavior: smooth; }

body {
  font-family: var(--sans);
  background: var(--warm-white);
  color: var(--deep);
  font-weight: 300;
  -webkit-font-smoothing: antialiased;
}

/* ── ANNOUNCEMENT ── */
.announcement {
  background: var(--deep);
  color: #d4c5b0;
  text-align: center;
  font-size: 10px;
  letter-spacing: 0.2em;
  padding: 10px;
  text-transform: uppercase;
}

/* ── NAV ── */
.nav {
  position: fixed;
  top: 32px;
  left: 0; right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 48px;
  height: 64px;
  transition: background 0.4s ease, top 0.4s ease, border-color 0.4s;
  border-bottom: 0.5px solid transparent;
}

.nav.scrolled {
  top: 0;
  background: rgba(250, 248, 244, 0.93);
  backdrop-filter: blur(12px);
  border-bottom-color: rgba(26,23,20,0.1);
}

.nav-logo {
  font-family: var(--serif);
  font-size: 22px;
  font-weight: 300;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: #fff;
  text-decoration: none;
  transition: color 0.4s;
}
.nav.scrolled .nav-logo { color: var(--deep); }

.nav-links {
  display: flex;
  gap: 40px;
  list-style: none;
}
.nav-links a {
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.85);
  text-decoration: none;
  transition: color 0.3s;
  font-weight: 300;
}
.nav.scrolled .nav-links a { color: var(--mid); }
.nav-links a:hover { color: var(--accent) !important; }

.nav-icons {
  display: flex;
  gap: 24px;
  align-items: center;
}
.nav-icons button,
.nav-icons a {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0;
  color: rgba(255,255,255,0.85);
  text-decoration: none;
  font-size: 10px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  font-family: var(--sans);
  font-weight: 300;
  transition: color 0.3s;
}
.nav.scrolled .nav-icons button,
.nav.scrolled .nav-icons a { color: var(--mid); }
.nav-icons button:hover,
.nav-icons a:hover { color: var(--accent) !important; }

/* ── HERO ── */
.hero {
  position: relative;
  height: 100vh;
  min-height: 700px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding-bottom: 80px;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-color: #c8b89a;
}
.hero-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0) 40%, rgba(0,0,0,0.35) 100%);
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 0 80px;
  max-width: 700px;
}

.hero-eyebrow {
  font-size: 10px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.7);
  margin-bottom: 20px;
  font-weight: 300;
}

.hero-title {
  font-family: var(--serif);
  font-size: clamp(52px, 7vw, 96px);
  font-weight: 300;
  font-style: italic;
  color: #fff;
  line-height: 1.05;
  letter-spacing: -0.01em;
  margin-bottom: 32px;
}

.hero-cta {
  display: inline-block;
  font-size: 10px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: #fff;
  text-decoration: none;
  border-bottom: 0.5px solid rgba(255,255,255,0.5);
  padding-bottom: 4px;
  transition: border-color 0.3s, letter-spacing 0.3s;
}
.hero-cta:hover {
  border-color: #fff;
  letter-spacing: 0.32em;
}

.hero-scroll {
  position: absolute;
  bottom: 40px;
  right: 80px;
  z-index: 2;
  writing-mode: vertical-rl;
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.5);
  display: flex;
  align-items: center;
  gap: 12px;
}
.hero-scroll::before {
  content: '';
  display: block;
  width: 0.5px;
  height: 48px;
  background: rgba(255,255,255,0.3);
}

/* ── MARQUEE ── */
.marquee-wrap {
  background: var(--sand);
  overflow: hidden;
  padding: 16px 0;
  border-top: 0.5px solid rgba(26,23,20,0.08);
  border-bottom: 0.5px solid rgba(26,23,20,0.08);
}
.marquee-track {
  display: flex;
  gap: 80px;
  white-space: nowrap;
  animation: marquee 28s linear infinite;
}
.marquee-track span {
  font-size: 9px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--mid);
  flex-shrink: 0;
}
.marquee-track span::before {
  content: '✦';
  margin-right: 80px;
  opacity: 0.4;
}
@keyframes marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* ── SECTION HEADER ── */
.section-header {
  text-align: center;
  padding: 80px 48px 48px;
}
.section-eyebrow {
  font-size: 9px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 16px;
}
.section-title {
  font-family: var(--serif);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 300;
  font-style: italic;
  letter-spacing: -0.01em;
  line-height: 1.1;
  color: var(--deep);
}

/* ── PRODUCT GRID ── */
.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 2px;
  padding: 0 2px 2px;
}

.product-card {
  position: relative;
  overflow: hidden;
  background: var(--sand);
  cursor: pointer;
}
.product-card--featured {
  grid-column: span 2;
  grid-row: span 2;
}
.product-card-link {
  display: block;
  text-decoration: none;
}

.product-img {
  width: 100%;
  aspect-ratio: 3/4;
  object-fit: cover;
  display: block;
  transition: transform 0.8s cubic-bezier(0.25,0.46,0.45,0.94);
  filter: brightness(0.97) saturate(0.95);
}
.product-img--placeholder {
  width: 100%;
  aspect-ratio: 3/4;
  background: var(--sand);
}
.product-card--featured .product-img {
  aspect-ratio: auto;
  height: 100%;
  position: absolute;
  inset: 0;
  width: 100%;
}
.product-card:hover .product-img { transform: scale(1.05); }

.product-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 28px;
  background: linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 50%);
  opacity: 0;
  transition: opacity 0.4s;
  pointer-events: none;
}
.product-card--featured .product-overlay {
  background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 55%);
  opacity: 1;
  pointer-events: auto;
}
.product-card:hover .product-overlay { opacity: 1; pointer-events: auto; }

.product-name {
  font-family: var(--serif);
  font-size: 20px;
  font-weight: 300;
  color: #fff;
  font-style: italic;
  margin-bottom: 6px;
}
.product-card--featured .product-name { font-size: 28px; }

.product-price {
  font-size: 11px;
  letter-spacing: 0.1em;
  color: rgba(255,255,255,0.75);
}

.product-quick-add {
  margin-top: 16px;
  display: inline-block;
  font-size: 9px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #fff;
  border: 0.5px solid rgba(255,255,255,0.5);
  padding: 10px 20px;
  transition: background 0.3s, border-color 0.3s;
  text-decoration: none;
  font-family: var(--sans);
  cursor: pointer;
}
.product-quick-add:hover {
  background: rgba(255,255,255,0.15);
  border-color: #fff;
}

.product-info {
  padding: 16px 20px;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.product-info-name {
  font-family: var(--serif);
  font-size: 15px;
  font-weight: 300;
  font-style: italic;
  color: var(--deep);
}
.product-info-price {
  font-size: 11px;
  color: var(--mid);
  letter-spacing: 0.05em;
}

.no-products {
  grid-column: 1 / -1;
  text-align: center;
  padding: 80px;
  color: var(--mid);
  font-size: 12px;
  letter-spacing: 0.1em;
}

/* ── VIEW ALL ── */
.view-all-wrap { text-align: center; padding: 0 0 80px; }
.view-all {
  display: inline-block;
  font-size: 10px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--deep);
  text-decoration: none;
  border-bottom: 0.5px solid var(--deep);
  padding-bottom: 4px;
  transition: letter-spacing 0.3s;
}
.view-all:hover { letter-spacing: 0.32em; }

/* ── EDITORIAL SPLIT ── */
.editorial {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 80vh;
  margin-top: 2px;
}
.editorial-image {
  position: relative;
  overflow: hidden;
}
.editorial-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  filter: saturate(0.9);
}
.editorial-image--placeholder {
  width: 100%;
  height: 100%;
  min-height: 600px;
  background: var(--sand);
}
.editorial-content {
  background: var(--deep);
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 80px;
}
.editorial-label {
  font-size: 9px;
  letter-spacing: 0.35em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 28px;
}
.editorial-title {
  font-family: var(--serif);
  font-size: clamp(36px, 4vw, 58px);
  font-weight: 300;
  color: #f5f0e8;
  line-height: 1.1;
  margin-bottom: 28px;
  font-style: italic;
}
.editorial-title em { color: var(--accent); }
.editorial-body {
  font-size: 13px;
  color: rgba(245,240,232,0.55);
  line-height: 1.9;
  max-width: 380px;
  margin-bottom: 44px;
  letter-spacing: 0.02em;
}
.editorial-cta {
  display: inline-flex;
  align-items: center;
  gap: 16px;
  font-size: 10px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--sand);
  text-decoration: none;
  transition: gap 0.3s;
}
.editorial-cta:hover { gap: 24px; }
.editorial-cta::after { content: '→'; font-size: 14px; }

/* ── LOOKBOOK ── */
.lookbook { padding: 80px 0; overflow: hidden; }
.lookbook-scroll {
  display: flex;
  gap: 2px;
  padding: 0 48px;
  overflow-x: auto;
  scrollbar-width: none;
  cursor: grab;
  -webkit-user-select: none;
  user-select: none;
}
.lookbook-scroll::-webkit-scrollbar { display: none; }
.lookbook-scroll:active { cursor: grabbing; }
.lookbook-item { flex-shrink: 0; width: 280px; }
.lookbook-item img {
  width: 100%;
  aspect-ratio: 2/3;
  object-fit: cover;
  display: block;
  filter: saturate(0.88) brightness(1.02);
  transition: transform 0.7s ease;
}
.lookbook-item--placeholder {
  width: 100%;
  aspect-ratio: 2/3;
  background: var(--sand);
}
.lookbook-item:hover img { transform: scale(1.04); }
.lookbook-caption {
  padding: 14px 0 8px;
  font-family: var(--serif);
  font-size: 14px;
  font-style: italic;
  color: var(--mid);
}

/* ── NEWSLETTER ── */
.newsletter {
  background: var(--sand);
  text-align: center;
  padding: 100px 48px;
  border-top: 0.5px solid rgba(26,23,20,0.08);
}
.newsletter-title {
  font-family: var(--serif);
  font-size: clamp(28px, 3.5vw, 48px);
  font-weight: 300;
  font-style: italic;
  color: var(--deep);
  margin-bottom: 12px;
}
.newsletter-sub {
  font-size: 11px;
  letter-spacing: 0.12em;
  color: var(--mid);
  margin-bottom: 44px;
  text-transform: uppercase;
}
.newsletter-form {
  display: flex;
  max-width: 480px;
  margin: 0 auto;
  border-bottom: 0.5px solid var(--deep);
}
.newsletter-form input {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  font-family: var(--sans);
  font-size: 12px;
  letter-spacing: 0.1em;
  color: var(--deep);
  padding: 14px 0;
  font-weight: 300;
}
.newsletter-form input::placeholder { color: var(--mid); }
.newsletter-form button {
  background: none;
  border: none;
  font-family: var(--sans);
  font-size: 9px;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--deep);
  cursor: pointer;
  padding: 14px 0 14px 24px;
  transition: color 0.3s;
}
.newsletter-form button:hover { color: var(--accent); }
.newsletter-success {
  margin-top: 20px;
  font-size: 11px;
  letter-spacing: 0.1em;
  color: var(--mid);
  text-transform: uppercase;
}

/* ── FOOTER ── */
.footer {
  background: var(--deep);
  color: rgba(245,240,232,0.45);
  padding: 72px 80px 40px;
}
.footer-top {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 48px;
  padding-bottom: 64px;
  border-bottom: 0.5px solid rgba(255,255,255,0.08);
}
.footer-brand-name {
  font-family: var(--serif);
  font-size: 24px;
  font-weight: 300;
  color: var(--sand);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin-bottom: 20px;
}
.footer-brand-desc {
  font-size: 12px;
  line-height: 1.8;
  max-width: 260px;
  letter-spacing: 0.02em;
}
.footer-col h4 {
  font-size: 9px;
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--sand);
  margin-bottom: 20px;
  font-weight: 300;
}
.footer-col ul {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.footer-col a {
  font-size: 12px;
  color: rgba(245,240,232,0.45);
  text-decoration: none;
  transition: color 0.3s;
  letter-spacing: 0.03em;
}
.footer-col a:hover { color: var(--accent); }
.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 32px;
  font-size: 10px;
  letter-spacing: 0.1em;
}
.footer-bottom a {
  color: rgba(245,240,232,0.45);
  text-decoration: none;
  transition: color 0.3s;
}
.footer-bottom a:hover { color: var(--accent); }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .nav { padding: 0 24px; }
  .nav-links { gap: 24px; }
  .hero-content { padding: 0 48px; }
  .footer { padding: 60px 48px 32px; }
  .footer-top { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 768px) {
  .nav-links { display: none; }
  .nav { padding: 0 24px; }
  .hero-content { padding: 0 24px; }
  .hero-scroll { right: 24px; }
  .product-grid { grid-template-columns: 1fr 1fr; }
  .product-card--featured { grid-column: span 2; grid-row: span 1; }
  .product-card--featured .product-img { position: static; height: auto; aspect-ratio: 3/4; }
  .editorial { grid-template-columns: 1fr; }
  .editorial-content { padding: 60px 32px; }
  .footer { padding: 48px 24px 32px; }
  .footer-top { grid-template-columns: 1fr 1fr; gap: 32px; }
  .lookbook-item { width: 220px; }
}
